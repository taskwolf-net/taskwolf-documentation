msgid "documentation.change.log.1.0.0.date"
msgstr "January 1, 2025"
msgid "documentation.change.log.1.0.0.description"
msgstr "The project was published on January 1, 2025. Since then, Taskwolf can be purchased and used by any interested customer."
msgid "documentation.change.log.beta.date"
msgstr "November 1, 2024"
msgid "documentation.change.log.beta.description"
msgstr "On November 1, 2024, the alpha development phase of Taskwolf was closed and the beta version was launched. In this phase, Taskwolf was tested by a larger group of participants to find and fix even the smallest bugs."
msgid "documentation.change.log.alpha.date"
msgstr "September 1, 2024"
msgid "documentation.change.log.alpha.description"
msgstr "On September 1, 2024, the alpha version of Taskwolf was made available for testing. In this phase of the project, the underlying functions were finalized and the project was tested in a small group."
msgid "documentation.change.log.begin.date"
msgstr "October 5, 2023"
msgid "documentation.change.log.begin.description"
msgstr "This date is considered the start of the Taskwolf project. Since that date, the Taskwolf team has been developing exciting automation features to make your everyday life easier."

