msgid "documentation.overview.help.button"
msgstr "Kontakt"

# CHANGE LOG
msgid "documentation.change.log.title"
msgstr "Veränderungen - Dulno"
msgid "documentation.change.log.headline"
msgstr "Veränderungen"
msgid "documentation.change.log.version"
msgstr "Version"
msgid "documentation.change.log.changes"
msgstr "Änderungen"
msgid "documentation.change.log.app.updates"
msgstr "App Aktualisierungen"
msgid "documentation.change.log.fixed.issues"
msgstr "Behobene Probleme"
msgid "documentation.change.log.1.0.0.date"
msgstr "1. Januar 2025"
msgid "documentation.change.log.1.0.0.description"
msgstr "Das Projekt wurde am 1. Januar 2025 veröffentlicht. Seitdem kann Dulno von jedem interessierten Kunden erworben und genutzt werden."
msgid "documentation.change.log.beta.date"
msgstr "1. November 2024"
msgid "documentation.change.log.beta.description"
msgstr "Am 1. November 2024 wurde die Alpha-Entwicklungsphase von Dulno abgeschlossen und die Beta-Version gestartet. In dieser Phase wurde Dulno von einer größeren Gruppe von Teilnehmern getestet, um auch die kleinsten Fehler zu finden und zu beheben."
msgid "documentation.change.log.alpha.date"
msgstr "1. September 2024"
msgid "documentation.change.log.alpha.description"
msgstr "Am 1. September 2024 wurde die Alpha-Version von Dulno zum Testen zur Verfügung gestellt. In dieser Phase des Projekts wurden die zugrunde liegenden Funktionen fertiggestellt und das Projekt in einer kleinen Gruppe getestet."
msgid "documentation.change.log.begin.date"
msgstr "5. Oktober 2023"
msgid "documentation.change.log.begin.description"
msgstr "Dieser Zeitpunkt gilt als der Beginn des Dulno-Projekts. Seit diesem Datum entwickelt das Dulno-Team aufregende Automatisierungsfunktionen, um Ihren Alltag zu erleichtern."

